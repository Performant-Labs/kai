# The Playbook's reusable CI resolves its @performant-labs/ci-controller
# dependency via `npx` (pinned in ci-reusable.yml). That package is published
# to GitHub Packages, not the public npm registry, so without this scope
# mapping `npx @performant-labs/ci-controller` 404s against
# registry.npmjs.org and the Plan (ci.yaml) / matrix jobs fail. This is the
# same two lines the fleet's other callers (easy-login, flotilla) ship. Auth
# is the per-job NODE_AUTH_TOKEN (CI: secrets.GITHUB_TOKEN).
@performant-labs:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
