<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<key>CFBundleExecutable</key>
		<string>Kai</string>
		<key>CFBundleGetInfoString</key>
		<string>A translation tool that lives in the system tray, with selection, screenshot and input translation plus built-in OCR.</string>
		<key>CFBundleIconFile</key>
		<string>icons</string>
		<key>CFBundleIconName</key>
		<string>appicon</string>
		<key>CFBundleIdentifier</key>
		<string>net.dtapp.kai</string>
		<key>CFBundleName</key>
		<string>Kai</string>
		<key>CFBundlePackageType</key>
		<string>APPL</string>
		<key>CFBundleShortVersionString</key>
		<string>0.1.0</string>
		<key>CFBundleVersion</key>
		<string>0.1.0</string>
		<key>LSMinimumSystemVersion</key>
		<string>12.0.0</string>
		<!-- LSUIElement removed (issue #165): this key is LaunchServices' own bundle-level switch
		     for "no Dock icon, no Cmd+Tab entry", read at launch before main.go's runtime
		     Mac.ActivationPolicy (application_darwin.go's setActivationPolicy call) has a chance
		     to run. Leaving it true here would fight the ActivationPolicyRegular change in
		     main.go, so both must agree for Kai to reliably get a Dock icon and Cmd+Tab entry. -->
		<key>NSHighResolutionCapable</key>
		<string>true</string>
		<key>NSHumanReadableCopyright</key>
		<string>(c) 2026, DTApp</string>
		<key>NSQuitAlwaysKeepsWindows</key>
		<false/>
	</dict>
</plist>