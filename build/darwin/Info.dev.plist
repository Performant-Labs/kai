<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<!-- Kai-dev: the development variant (make dev-app, docs/dev-signing.md). Its name and bundle
	     identifier differ from the released Kai (build/darwin/Info.plist) so macOS treats them as
	     two apps: separate rows in Privacy & Security, separate grants. The identifier is the prod
	     one plus ".dev". CFBundleExecutable stays "Kai" (the Go binary is bin/Kai). The version here
	     is a placeholder: the running version comes from the -ldflags the build injects, and
	     scripts/release-bump.sh edits only Info.plist. -->
	<dict>
		<key>CFBundleDisplayName</key>
		<string>Kai-dev</string>
		<key>CFBundleExecutable</key>
		<string>Kai</string>
		<key>CFBundleGetInfoString</key>
		<string>A translation tool that lives in the system tray, with selection, screenshot and input translation plus built-in OCR.</string>
		<key>CFBundleIconFile</key>
		<string>icons</string>
		<key>CFBundleIconName</key>
		<string>appicon</string>
		<key>CFBundleIdentifier</key>
		<string>com.performantlabs.kai.dev</string>
		<key>CFBundleName</key>
		<string>Kai-dev</string>
		<key>CFBundlePackageType</key>
		<string>APPL</string>
		<key>CFBundleShortVersionString</key>
		<string>0.0.1</string>
		<key>CFBundleVersion</key>
		<string>0.0.1</string>
		<key>LSMinimumSystemVersion</key>
		<string>12.0.0</string>
		<!-- LSUIElement removed (issue #165): see build/darwin/Info.plist's comment — this must
		     stay in sync with main.go's Mac.ActivationPolicy (ActivationPolicyRegular). -->
		<key>NSAppTransportSecurity</key>
		<dict>
			<key>NSAllowsLocalNetworking</key>
			<true/>
		</dict>
		<key>NSHighResolutionCapable</key>
		<string>true</string>
		<key>NSHumanReadableCopyright</key>
		<string>(c) 2026, DTApp</string>
		<key>NSQuitAlwaysKeepsWindows</key>
		<false/>
	</dict>
</plist>