{
  "pathSets": {
    "tests": [
      "main*_test.go",
      "internal/*/*_test.go",
      "internal/*/*/*_test.go",
      "internal/*/testdata/**",
      "internal/*/*/testdata/**",
      "pkg/*/*_test.go",
      "pkg/*/*/*_test.go",
      "pkg/*/testdata/**",
      "scripts/*.test.sh",
      "frontend/src/*/*.test.*",
      "frontend/src/*/*/*.test.*"
    ],
    "handoffs": [
      "docs/handoffs/**"
    ],
    "production": [
      "internal/**",
      "pkg/**",
      "main*.go",
      "frontend/src/**",
      "scripts/*.sh",
      "docs/releasing.md",
      "docs/release-checklist.md"
    ]
  },
  "mergeMode": "auto",
  "toolchain": "kai",
  "testSuites": {
    "unit": {
      "filter": "none",
      "command": "bash scripts/test-unit.sh",
      "timeoutMs": 900000
    }
  },
  "handoffDirectory": "docs/handoffs",
  "defaultIsolationLevel": "worktree"
}
