{
  "testCommands": [
    "bash scripts/test-unit.sh"
  ],
  "pathSets": {
    "tests": [
      "internal/*_test.go",
      "pkg/*_test.go",
      "main_*_test.go",
      "frontend/src/*.test.*",
      "frontend/vitest.*",
      "scripts/*.test.sh"
    ],
    "handoffs": [
      "docs/handoffs/**",
      ".worktrees/*/docs/handoffs/**"
    ],
    "production": [
      "internal/**",
      "pkg/**",
      "main.go",
      "main_*.go",
      "frontend/src/**",
      "pkg/swiftbridge/**",
      "frontend/vite.config.ts",
      "scripts/*.sh",
      "docs/releasing.md",
      "docs/release-checklist.md"
    ]
  },
  "mergeMode": "auto",
  "toolchain": "kai",
  "testSuites": {
    "unit": {
      "filter": "none",
      "script": [
        "bash scripts/test-unit.sh"
      ],
      "timeoutMs": 900000
    }
  },
  "handoffDirectory": "docs/handoffs",
  "defaultIsolationLevel": "worktree",
  "gitHooks": {
    "required": false
  }
}
