{
  "configShapeVersion": 1,
  "project": "kai",
  "description": "Menu-bar translation app (Wails: Go backend, Svelte UI, Swift system bridge).",
  "test": {
    "unit": {
      "command": [
        "sh",
        "-c",
        "(cd pkg/swiftbridge/scripts && bash ./build.sh) && go test -vet=off ./internal/... ./pkg/... -count=1 && pnpm --dir frontend test && bash scripts/release.test.sh && bash scripts/release-ask-ai.test.sh"
      ],
      "timeoutMs": 900000
    },
    "pluginSuite": null,
    "pluginTypecheck": null
  },
  "paths": {
    "test": [
      "**/*_test.go",
      "**/testdata/**",
      "scripts/*.test.sh"
    ],
    "production": [
      "internal/**",
      "pkg/**",
      "main.go",
      "frontend/src/**",
      "**/*.swift",
      "scripts/*.sh",
      "docs/releasing.md",
      "docs/release-checklist.md"
    ]
  },
  "toolchain": [
    {
      "name": "go",
      "command": [
        "go",
        "version"
      ],
      "versionRegex": "go(\\d+\\.\\d+(?:\\.\\d+)?)",
      "pin": {
        "sources": [
          {
            "file": "go.mod",
            "regex": "^go\\s+(\\d+(?:\\.\\d+){1,2})"
          }
        ],
        "compare": "at-least"
      }
    },
    {
      "name": "swiftc",
      "command": [
        "swiftc",
        "--version"
      ],
      "versionRegex": "Swift version (\\d+\\.\\d+(?:\\.\\d+)?)",
      "hint": "install Xcode command line tools"
    }
  ],
  "secretScan": {
    "required": false,
    "command": [
      "gitleaks",
      "version"
    ],
    "hint": "brew install gitleaks"
  },
  "handoffs": {
    "dir": "docs/handoffs",
    "trackedProbe": "decisions.md"
  },
  "worktree": {
    "dir": ".worktrees",
    "basePort": 9000,
    "linkDirs": []
  },
  "gateProvider": null,
  "gitHooks": {
    "required": false,
    "setupHint": "run the project's hook setup script"
  }
}
